{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウ (設定画面) に与える権限。トレイ常駐 + サイドカー起動 + 自動起動のみ。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "autostart:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/jp-pii-mask-server",
          "sidecar": true
        }
      ]
    }
  ]
}
